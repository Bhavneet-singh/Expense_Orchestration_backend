    {
      "id": "arch0059",
      "type": "text",
      "x": 1597,
      "y": 931,
      "width": 631,
      "height": 217,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
