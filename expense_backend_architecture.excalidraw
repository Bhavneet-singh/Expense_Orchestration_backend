    {
      "id": "arch0056",
      "type": "text",
      "x": 842,
      "y": 931,
      "width": 671,
      "height": 217,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0056",
      "roundness": null,
      "seed": 7156,
      "version": 1,
      "versionNonce": 8156,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792778197117,
      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 2,
      "text": "Pairwise view: sum each split as a debt to its expense payer, then match\naggregate debtors and creditors into transfers.\n\nNet view: initialize each current member at 0 paise; for every split,\nsubtract from the owing member and add to the payer.\n\nBoth views are computed from stored expense data on request. No balance\nrows/table are maintained.",
      "originalText": "Pairwise view: sum each split as a debt to its expense payer, then match\naggregate debtors and creditors into transfers.\n\nNet view: initialize each current member at 0 paise; for every split,\nsubtract from the owing member and add to the payer.\n\nBoth views are computed from stored expense data on request. No balance\nrows/table are maintained.",
      "autoResize": true,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3
    },
